# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
venv/
env/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
wheelhouse/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/
# Cargo.lock is committed on purpose: this is an application, not a library.

# Runtime and user data
#
# The whole directory is ignored rather than an enumerated list of filenames.
# SQLite in WAL mode creates history.db-wal / history.db-shm beside history.db,
# and a damaged config is rebuilt into config.json.corrupt containing absolute
# model paths. Derived names cannot be enumerated, so a per-file list would
# eventually miss one.
data/
backend/data/

# Build output
*.exe
*.msi
*.app
*.dmg
*.AppImage
*.deb
*.zip
*.7z
# Staged by src-tauri/build.rs as a bundle resource.
src-tauri/backend/
# PyInstaller onedir runtime, deployed beside backend.exe.
backend/_internal/

# Logs
debug.log
stdout.txt
stderr.txt
*.log

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~
# A *.bak* copy sits next to the live file with nearly the same name; published,
# a reader would take it for the real thing.
*.bak*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
# Windows shortcuts store the target executable's absolute path as UTF-16LE.
# A content privacy scan skips binaries, so this has to be ignored here.
*.lnk

# Local runtime directories the packaged app creates next to the executable
# (WebView2 profile, fallback logs, extraction temp). Running a portable build
# from a source checkout creates them at the repository root.
webview2-data/
logs/
runtime-temp/
appdata/
shots/

# Secrets and local configuration overrides
config.local.json
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
credentials*.json
secrets*.json
SHA256SUMS.txt

# Local databases
*.db
*.sqlite
*.sqlite3

# Local scratch space and tool state.
# These directories hold machine-specific absolute paths and session data. None
# of it is source, and none of it should reach the published tree.
tmp/
study/
docs/archive/

# Contributor-local tooling state.
#
# Editor and assistant integrations create their own state directories beside
# the code and sometimes drop an instruction file at the repository root. All of
# it describes one machine's setup and carries absolute paths, so it stays out
# of the repository. The patterns are generic on purpose: this file is itself
# published, and naming individual tools would document a private toolchain
# rather than protect the tree.
.*-session/
*-session-*/
